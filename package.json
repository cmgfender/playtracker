{
  "name": "playtracker",
  "version": "1.0.0",
  "description": "Self-hosted game playtime & session tracker for Steam, Xbox and PlayStation",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js test/suite/*.test.js",
    "demo": "node --disable-warning=ExperimentalWarning src/demo.js",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.js"
  },
  "license": "MIT"
}
